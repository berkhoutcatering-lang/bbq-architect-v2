# ── Zo gebruik je dit bestand ─────────────────────────────────────────────────
# Kopieer naar .env.local voor lokaal werk. Zet dezelfde sleutels in Vercel →
# project → Settings → Environment Variables voor productie.
#
# Een lege regel hieronder betekent: die variabele bestaat, maar staat hier niet
# ingevuld. Alles met NEXT_PUBLIC_ ervoor gaat mee in de bundel die elke
# bezoeker binnenhaalt — zet daar dus nooit een geheime sleutel in.

# ── Verplicht: zonder deze vier start de app niet fatsoenlijk ─────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role sleutel: omzeilt RLS. Alleen server-side, nooit in de browser.
SUPABASE_SERVICE_ROLE_KEY=
# Anthropic-sleutel voor alle AI-functies (chat, ontleder, bon-uitlezer).
ANTHROPIC_API_KEY=

# ── E-mail (Resend) — BLOKKEREND voor aanvragen vanaf de website ─────────────
# Zonder deze twee verstuurt de app géén enkele mail en faalt dat stil: de lead
# wordt wél opgeslagen, de klant hoort niets. Dat raakt onder andere:
#   - /api/public-lead-form/{slug}  → bevestiging klant + melding cateraar
#   - /api/public-arrangement/{slug}
#   - offerte- en factuurverzending, inkooporders, boekhoudpakket, /api/contact
RESEND_API_KEY=
# Afzender. Moet een geverifieerd domein in Resend zijn, in de vorm
# "Naam <adres@domein.nl>". Niet gezet? Dan valt de app terug op
# onboarding@resend.dev — dat werkt alleen naar je eigen Resend-account.
RESEND_FROM_EMAIL=

# ── Experience-app (satelliet: doostypes, tokens) ────────────────────────────
# Basis-URL van de Experience-app, zonder slash op het eind.
EXPERIENCE_API_URL=
# Gedeelde sleutel. Heet bewust NIET NEXT_PUBLIC_ of VITE_ — die voorvoegsels
# bakken de waarde in de publieke bundel. Een test bewaakt dat.
EXPERIENCE_API_KEY=

# ── Cron-taken ───────────────────────────────────────────────────────────────
# Gedeeld geheim voor /api/cron/*. Vercel-crons sturen de header X-Vercel-Cron;
# alle andere aanroepers moeten "Authorization: Bearer <dit>" meesturen.
# Niet gezet? Dan weigeren de cron-routes álles — ook de echte cron.
CRON_SECRET=

# ── Aanbieder-gegevens voor de juridische pagina's ────────────────────────────
# Publiek zichtbaar op /legal/privacy, /legal/voorwaarden en /legal/dpa.
# Niet gezet? Dan laten die pagina's de zin met KvK en adres weg in plaats van
# een streepje te tonen — "KvK —" leest als "wij hebben geen KvK-nummer".
NEXT_PUBLIC_COMPANY_NAME=Berkhout Catering
NEXT_PUBLIC_KVK_NUMBER=
NEXT_PUBLIC_COMPANY_ADDRESS=

# Zet op 1 zodra een jurist de drie juridische teksten heeft beoordeeld. Dan
# verdwijnt de concept-melding op alle drie de pagina's tegelijk.
NEXT_PUBLIC_LEGAL_REVIEWED=

# ── Support-contact op /contact ──────────────────────────────────────────────
# Niet gezet? Dan toont /contact support@bbqarchitect.nl en géén telefoonnummer.
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=

# ── App-URL ──────────────────────────────────────────────────────────────────
# Volledige basis-URL van deze installatie (https://…, zonder slash op het eind).
# Gebruikt voor deelbare links en als terugval-redirect na een betaling.
NEXT_PUBLIC_APP_URL=

# ── Platformbeheer ───────────────────────────────────────────────────────────
# Komma-gescheiden e-mailadressen die het platformbeheer mogen zien.
# De NEXT_PUBLIC_-variant stuurt de pagina /admin/funnel, de gewone variant
# beveiligt /api/admin/*. Zijn ze leeg, dan geldt de standaardcontrole.
PLATFORM_ADMIN_EMAILS=
NEXT_PUBLIC_PLATFORM_ADMIN_EMAILS=

# ── Optioneel: betalen (Mollie) ──────────────────────────────────────────────
# Zonder MOLLIE_API_KEY blijft de betaalknop uit; de rest van de app werkt.
MOLLIE_API_KEY=
MOLLIE_WEBHOOK_URL=
MOLLIE_REDIRECT_URL=

# ── Optioneel: boekhouding (Moneybird) ───────────────────────────────────────
MONEYBIRD_CLIENT_ID=
MONEYBIRD_CLIENT_SECRET=
MONEYBIRD_REDIRECT_URI=
MONEYBIRD_TOKEN=
MONEYBIRD_ADMINISTRATION_ID=
# BTW-tarief-id's uit Moneybird zelf. Nooit raden: verkeerde id = verkeerde BTW.
MONEYBIRD_TAX_RATE_0=
MONEYBIRD_TAX_RATE_9=
MONEYBIRD_TAX_RATE_21=

# ── Optioneel: boekhouding (Exact Online) ────────────────────────────────────
EXACT_CLIENT_ID=
EXACT_CLIENT_SECRET=
EXACT_REFRESH_TOKEN=
EXACT_DIVISION=
EXACT_JOURNAL_CODE=
EXACT_GL_ACCOUNT_GUID=
EXACT_PAYMENT_TERMS_CODE=

# ── Optioneel: Google Agenda-synchronisatie ──────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# ── Optioneel: e-mail binnenkomend (prijslijsten per mail) ───────────────────
# Gedeeld geheim waarmee de Cloudflare Email Worker zich meldt bij
# /api/email/inbound. INTERNAL_PARSE_TOKEN beveiligt de interne doorgifte naar
# /api/parse-attachment.
EMAIL_INBOUND_SECRET=
INTERNAL_PARSE_TOKEN=

# ── Ontwikkeling en tests ────────────────────────────────────────────────────
# Vult de snelle-login-knop op /login. Alleen lokaal invullen, nooit in productie.
NEXT_PUBLIC_DEV_QUICK_EMAIL=
NEXT_PUBLIC_DEV_QUICK_PASSWORD=
# Zet op 1 om de Playwright-routes onder /e2e-test/* te openen.
NEXT_PUBLIC_E2E=
# Map met echte facturen voor de bon-uitlezer-meetbank (vitest bench).
BON_BENCH_DIR=
BON_BENCH_ONLY=
# Afstelling van de prijslijst-import; leeg = de standaardwaarden in de code.
PRICELIST_CHUNK_SIZE=
PRICELIST_SYNC_PAGE_THRESHOLD=
