{
  "manifest_version": 3,
  "name": "BBQ Architect — Leverancierssync",
  "version": "0.7.0",
  "minimum_chrome_version": "120",
  "description": "Hervatbare, herleidbare synchronisatie van leveranciersprijzen naar BBQ Architect. Werkt op de ingelogde leverancierssite; de server bewaakt run, volledigheid en datakwaliteit.",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "offscreen",
    "sidePanel",
    "tabs"
  ],
  "optional_host_permissions": [
    "https://*.baktotaal.nl/*",
    "https://baktotaal.nl/*",
    "https://*.makro.nl/*",
    "https://*.sligro.nl/*",
    "https://*.hanos.nl/*",
    "https://*.bidfood.nl/*",
    "https://*.vuurenrook.nl/*"
  ],
  "background": {
    "service_worker": "background/sw.js",
    "type": "module"
  },
  "action": {
    "default_title": "BBQ Architect — Leverancierssync"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "options_page": "options.html"
}
